# Copy this file to `.env` and adjust the values, then run:
#   docker compose up -d --build
#
# `.env` is git-ignored so real credentials never get committed.

# Host port the Halo blog is published on.
HALO_PORT=8090

# MySQL database / credentials (shared by the halo-mysql and halo services).
HALO_DB_NAME=halo
HALO_DB_USERNAME=halo
HALO_DB_PASSWORD=please-change-me
HALO_DB_ROOT_PASSWORD=please-change-me-root
